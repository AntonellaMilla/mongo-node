<form action="/posts/create" method="POST">
  <input type="text" name="title" placeholder="Título" required minlength="5" maxlength="30">
  <textarea name="content" placeholder="Contenido" required minlength="10"></textarea>
  <input type="text" name="hashtags" placeholder="#hashtags separados por coma">
  <input type="text" name="imageUrl" placeholder="URL de imagen">
  <input type="text" name="userId" placeholder="ID de Usuario">
  <button type="submit" class="btn">Guardar</button>
</form>
